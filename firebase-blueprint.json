        "approvedBy": { "type": "string", "maxLength": 120 },
        "generatedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "planNumber", "district", "status", "totalSupplyUnits", "totalDemandUnits"]
    },
    "DrugRequisition": {
