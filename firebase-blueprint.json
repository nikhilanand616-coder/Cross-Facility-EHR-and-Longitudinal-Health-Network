        "assignedRoom": { "type": "string", "maxLength": 64 },
        "assignedDoctor": { "type": "string", "maxLength": 120 },
        "consultationStartTime": { "type": "string" },
        "consultationDurationMinutes": { "type": "number" },
        "expectedConsultationDuration": { "type": "number" },
        "esiTier": { "type": "number" },
        "urgencyScore": { "type": "number" },
        "isEmergencyEscalated": { "type": "boolean" },
        "emergencyReason": { "type": "string", "maxLength": 500 },
        "geminiTriageSummary": { "type": "object" },
        "priorityScore": { "type": "number" },
        "queuePosition": { "type": "number" },
        "estimatedWaitMinutes": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "tokenNumber", "patientId", "patientName", "facilityId", "status"]
    },
    "MedicineDistributionPlan": {
      "title": "MedicineDistributionPlan",
      "description": "Weekly tiered essential medicine distribution and transportation optimization plan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "planNumber": { "type": "string", "maxLength": 64 },
        "district": { "type": "string", "maxLength": 64 },
        "state": { "type": "string", "maxLength": 64 },
        "weekNumber": { "type": "number" },
        "year": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["draft", "optimized", "approved", "dispatched", "in_transit", "completed"]
